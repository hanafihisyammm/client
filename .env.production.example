# Production Environment Configuration
# Copy this to .env for production deployment

APP_NAME="Sidra Desk"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_APP_KEY_FOR_PRODUCTION
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (Use secure credentials)
DB_CONNECTION=pgsql
DB_HOST=your_production_db_host
DB_PORT=5432
DB_DATABASE=your_production_db_name
DB_USERNAME=your_production_db_user
DB_PASSWORD=your_secure_db_password

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# "Remember me" keeps a browser signed in while it is used; it must log in again after this many days unused
PERSISTENT_LOGIN_IDLE_DAYS=90

# Broadcasting
BROADCAST_CONNECTION=log

# File Storage
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-s3-bucket-name
AWS_USE_PATH_STYLE_ENDPOINT=false

# Queue Configuration
QUEUE_CONNECTION=redis

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=your_redis_host
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=emailit
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend
VITE_APP_NAME="${APP_NAME}"

# Security
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,*.yourdomain.com

# EmailIt API Configuration
EMAILIT_API_KEY=your_production_emailit_api_key

# Remove development keys in production!
# XENDIT_SECRET_KEY=
# XENDIT_PUBLIC_KEY=
# XENDIT_WEBHOOK_TOKEN=